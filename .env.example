# ============================================================
# GATE AI - Environment Variables
# Copy this file to .env.local and fill in real values locally.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# --- Database (Neon PostgreSQL) ---
# Example: postgresql://user:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth ---
# Random long secret used to sign session tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# --- Initial bootstrap user (used only by prisma/seed.ts) ---
INITIAL_ADMIN_USERNAME=pushpendra
INITIAL_ADMIN_PASSWORD=

# --- Optimizer AI (Stage 1 of the pipeline) ---
OPTIMIZER_API_KEY=
OPTIMIZER_API_URL=
OPTIMIZER_MODEL=

# --- Luna / Amazon Bedrock (Stage 2 of the pipeline) ---
LUNA_API_KEY=
LUNA_API_URL=
LUNA_MODEL_ID=
AWS_REGION=

# --- App config ---
APP_TIMEZONE=Asia/Kolkata
TARGET_EXAM_DATE=2027-02-07